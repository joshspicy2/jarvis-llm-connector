# Copy to /etc/jarvis-llm/env on the server (chmod 600). Never commit real values.
GEMINI_API_KEY=
# Random path secret. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CONNECTOR_SECRET=
# Public hostname Caddy serves this on (used for DNS-rebinding protection)
ALLOWED_HOSTS=llm.hightidewash.net
# Optional overrides
GEMINI_MODEL=gemini-3.8-flash
HOST=127.0.0.1
PORT=8787
REQUEST_TIMEOUT_SECONDS=180
MAX_OUTPUT_TOKENS=8000
# Optional: self-hosted FreeLLMAPI router (https://github.com/tashfeenahmed/freellmapi). Leave both
# empty to keep the free_llm_ask tool off. Base URL must be https, or http on localhost.
FREELLMAPI_BASE_URL=
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto
