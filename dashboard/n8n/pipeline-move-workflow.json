   "name": "Notion Get Job",
   "type": "n8n-nodes-base.notion",
   "typeVersion": 2.2,
   "position": [
    660,
    0
   ],
   "onError": "continueRegularOutput",
   "alwaysOutputData": true,
   "credentials": {
    "notionApi": {
     "id": "",
     "name": "Select your Notion credential"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "const PIPELINE_DB = \"6cc3d9aad6d14fa39377673274a4cc5f\";\nconst norm = s => String(s || \"\").replace(/-/g, \"\").toLowerCase();\nconst req = $(\"Validate Move\").first().json;\nconst reject = (code, error) => [{ json: { ok: false, code, error } }];\nconst p = $input.first().json;\nif (!p || p.error || !p.id) return reject(404, \"page not found or not readable\");\nif (norm(p.id) !== norm(req.id)) return reject(409, \"page id mismatch\");\nif (p.archived === true || p.in_trash === true) return reject(409, \"page is archived\");\nconst dbId = p.parent && p.parent.type === \"database_id\" ? p.parent.database_id : \"\";\nif (norm(dbId) !== PIPELINE_DB) return reject(409, \"page does not belong to the Pipeline database\");\nconst st = (p.properties || {})[\"Status\"];\nif (!st || st.type !== \"select\") return reject(409, \"page has no Status select\");\nconst from = st.select ? st.select.name || \"\" : \"\";\nif (from === req.status) return reject(409, \"job is already \" + req.status);\nreturn [{ json: { ok: true, id: p.id, from, to: req.status } }];"
   },
