{
 "name": "Jarvis Pipeline Move",
 "nodes": [
  {
   "parameters": {
    "httpMethod": "POST",
    "path": "jarvis/pipeline/move",
    "responseMode": "responseNode",
    "options": {
     "allowedOrigins": "https://REPLACE_WITH_DASHBOARD_ORIGIN"
    }
   },
   "name": "Move POST",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2,
   "position": [
    0,
    0
   ],
   "webhookId": "jarvis-pipeline-movepost"
  },
  {
   "parameters": {
    "jsCode": "const STATUSES = [\"Booked\", \"In Progress\", \"Awaiting Invoice\", \"Paid\", \"Flagged\"];\nconst b = $input.first().json.body;\nconst bad = error => [{ json: { valid: false, error } }];\nif (!b || typeof b !== \"object\" || Array.isArray(b)) return bad(\"body must be a JSON object\");\nconst extra = Object.keys(b).filter(k => k !== \"id\" && k !== \"status\");\nif (extra.length) return bad(\"unexpected field: \" + extra[0]);\nif (typeof b.id !== \"string\" || !/^([0-9a-f]{32}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$/i.test(b.id)) return bad(\"id must be a Notion page id\");\nif (typeof b.status !== \"string\" || !STATUSES.includes(b.status)) return bad(\"status must be one of: \" + STATUSES.join(\", \"));\nreturn [{ json: { valid: true, id: b.id, status: b.status } }];"
   },
   "name": "Validate Move",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    220,
    0
   ]
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "typeValidation": "strict"
     },
     "conditions": [
      {
       "id": "c1",
       "leftValue": "={{ $json.valid }}",
       "rightValue": "",
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   },
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "name": "Move Valid?",
   "position": [
    440,
    0
   ]
  },
  {
