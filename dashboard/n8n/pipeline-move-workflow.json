    "responseBody": "={{ JSON.stringify({ error: $json.error }) }}",
    "options": {
     "responseCode": 400
    }
   },
   "name": "Respond Bad Request",
   "type": "n8n-nodes-base.respondToWebhook",
   "typeVersion": 1.1,
   "position": [
    440,
    200
   ]
  },
  {
   "parameters": {
    "resource": "databasePage",
