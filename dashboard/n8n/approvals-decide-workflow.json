{
 "name": "Jarvis Approvals Decide",
 "nodes": [
  {
   "parameters": {
    "httpMethod": "POST",
    "path": "jarvis/approvals/decide",
    "responseMode": "responseNode",
    "options": {
     "allowedOrigins": "https://REPLACE_WITH_DASHBOARD_ORIGIN"
    }
   },
   "name": "Decide Webhook",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2,
   "position": [
    0,
    0
   ],
   "webhookId": "jarvis-approvals-decide"
  },
  {
   "parameters": {
    "jsCode": "\nconst raw = $input.first().json.body;\nconst b = raw && typeof raw === 'object' && !Array.isArray(raw) ? raw : {};\nconst errors = [];\nconst id = typeof b.id === 'string' ? b.id.trim() : '';\nif (!/^([0-9a-f]{32}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$/i.test(id)) errors.push('id must be a Notion page id');\nconst decision = typeof b.decision === 'string' ? b.decision : '';\nif (decision !== 'approve' && decision !== 'reject') errors.push(\"decision must be 'approve' or 'reject'\");\nconst by = typeof b.decided_by === 'string' ? b.decided_by.trim() : '';\nif (by.length < 1 || by.length > 60) errors.push('decided_by must be 1-60 characters');\nelse if (/[\\u0000-\\u001f\\u007f<>]/.test(by)) errors.push('decided_by contains invalid characters');\nconst valid = errors.length === 0;\nreturn [{ json: { valid, errors, id: valid ? id.toLowerCase() : '', decision: valid ? decision : '', decided_by: valid ? by : '', new_status: valid ? (decision === 'approve' ? 'Approved' : 'Rejected') : '' } }];\n"
   },
   "name": "Validate",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    220,
    0
   ]
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "typeValidation": "loose"
     },
     "combinator": "and",
     "conditions": [
      {
       "id": "c1",
       "leftValue": "={{ $json.valid }}",
       "rightValue": true,
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ]
    },
    "options": {}
   },
   "name": "Input valid?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    440,
    0
   ]
  },
  {
