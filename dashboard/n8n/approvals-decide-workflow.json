    }
   }
  },
  {
   "parameters": {
    "jsCode": "\nconst v = $('Validate').first().json;\nconst p = $input.first().json || {};\nconst pr = p.properties || {};\nconst text = x => !x ? '' : x.select ? (x.select.name || '') : x.title ? x.title.map(t => t.plain_text).join('') : '';\nconst norm = s => String(s || '').replace(/-/g, '').toLowerCase();\nconst APPROVALS_DB = 'a807f4c25dfe4ce388626726b7d99f6d';\nlet error = '';\nif (!p.id || norm(p.id) !== norm(v.id)) error = 'Approval not found';\nelse if (!p.parent || norm(p.parent.database_id) !== APPROVALS_DB) error = 'Page is not an Approvals row';\nelse if (text(pr.Status) !== 'Awaiting Approval') error = 'Approval is not Awaiting Approval; it cannot be decided';\nreturn [{ json: { can_decide: error === '', error } }];\n"
   },
   "name": "Guard",
