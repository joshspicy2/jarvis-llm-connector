      "name": "Notion System Flags",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ],
      "executeOnce": true,
      "alwaysOutputData": true,
      "credentials": {
        "notionApi": {
          "id": "",
          "name": "Select your Notion credential"
        }
      }
