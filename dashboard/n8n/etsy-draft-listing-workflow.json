    {
      "parameters": {
        "jsCode": "// Summarize. Draft only: the listing stays inactive until a human publishes it in Etsy.\nconst v = $('Validate Draft').first().json;\nconst created = $('Create Draft Listing').first().json || {};\nconst listing_id = created.listing_id || null;\nlet ok_i = 0, ok_f = 0, failed = 0;\nfor (const it of $input.all()) {\n  const j = it.json || {};\n  if (j.error || j.errors) { failed++; continue; }\n  if (j.listing_image_id) ok_i++; else if (j.listing_file_id) ok_f++;\n}\nconst wanted = v.uploads.length;\nfailed = Math.max(failed, wanted - ok_i - ok_f);\nconst base = \"/your/shops/me/listing-editor/edit/\";\nreturn [{ json: { body: { ok: !!listing_id, state: \"draft\", listing_id, title: v.title, uploads: { images: ok_i, files: ok_f, failed }, edit_path: listing_id ? base + listing_id : null, note: \"Draft only. A human reviews and publishes it in Etsy.\" } } }];",
        "mode": "runOnceForAllItems"
      },
      "name": "Collect Results",
      "type": "n8n-nodes-base.code",
