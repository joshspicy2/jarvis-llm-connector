      "parameters": {
        "jsCode": "// Fan out one item per image/file for the listing that was just created as a draft.\nconst v = $('Validate Draft').first().json;\nconst created = $('Create Draft Listing').first().json || {};\nconst listing_id = created.listing_id;\nif (!listing_id) return [{ json: { listing_id: null, kind: \"none\" } }];\nif (!v.uploads.length) return [{ json: { listing_id, kind: \"none\" } }];\nreturn v.uploads.map(u => ({ json: Object.assign({ listing_id }, u) }));"
