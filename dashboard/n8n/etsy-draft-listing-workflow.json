      "parameters": {
        "jsCode": "// Validate a draft-listing request. Draft only: state is forced to draft, nothing is ever published.\nconst body = ($input.first().json.body) || {};\nconst clean = (s, max) => String(s == null ? \"\" : s).replace(/[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]/g, \"\").trim().slice(0, max);\nconst err = (status, error) => [{ json: { valid: false, status, error } }];\nconst title = clean(body.title, 140);\nconst description = clean(body.description, 20000);\nconst price = Number(body.price);\nconst quantity = Math.floor(Number(body.quantity == null ? 999 : body.quantity));\nconst taxonomy_id = Math.floor(Number(body.taxonomy_id));\nconst tags = Array.isArray(body.tags) ? body.tags.map(t => clean(t, 20).toLowerCase()).filter(Boolean) : [];\nconst httpsOnly = u => /^https:\\/\\/[^\\s]+$/.test(String(u || \"\"));\nconst files = Array.isArray(body.files) ? body.files : [];\nconst images = Array.isArray(body.images) ? body.images : [];\nif (!title) return err(400, \"title required (max 140 chars)\");\nif (!description) return err(400, \"description required\");\nif (!(price > 0 && price < 10000)) return err(400, \"price must be a number between 0 and 10000\");\nif (!(quantity >= 1 && quantity <= 999)) return err(400, \"quantity must be 1 to 999\");\nif (!(taxonomy_id > 0)) return err(400, \"taxonomy_id required (Etsy category id)\");\nif (tags.length > 13) return err(400, \"max 13 tags\");\nif (new Set(tags).size !== tags.length) return err(400, \"duplicate tags\");\nif (files.length > 5) return err(400, \"max 5 digital files\");\nif (images.length > 20) return err(400, \"max 20 images\");\nif (!files.every(f => f && httpsOnly(f.url)) || !images.every(i => i && httpsOnly(i.url))) return err(400, \"every file/image needs an https url\");\nconst etsy = {\n  title, description, price: price.toFixed(2), quantity, taxonomy_id,\n  who_made: \"i_did\", when_made: \"2020_2026\", is_supply: \"false\",\n  type: \"download\", state: \"draft\",\n  tags: tags.join(\",\")\n};\nconst uploads = [];\nimages.forEach((i, idx) => uploads.push({ kind: \"image\", url: String(i.url), name: clean(i.name || (\"image-\" + (idx + 1) + \".jpg\"), 100), rank: idx + 1 }));\nfiles.forEach((f, idx) => uploads.push({ kind: \"file\", url: String(f.url), name: clean(f.name || (\"file-\" + (idx + 1) + \".pdf\"), 100), rank: idx + 1 }));\nreturn [{ json: { valid: true, etsy, uploads, title } }];"
      },
      "name": "Validate Draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
