  },
  {
   "parameters": {
    "method": "POST",
    "url": "https://REPLACE_WITH_N8N_BASE/webhook/jarvis/estimate",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ job_name: $('Validate').first().json.job_name, items: $('Validate').first().json.items, notes: $('Validate').first().json.text }) }}",
    "options": {
     "timeout": 60000
    }
   },
   "name": "Call Estimator",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1320,
    40
   ],
   "onError": "continueErrorOutput",
   "executeOnce": true
  },
  {
   "parameters": {
    "jsCode": "\nconst d = $('Decide').first().json;\nconst down = d.path === 'support' || d.path === 'estimator_items';\nlet ds, extra = {}, note = d.why;\nif (down) {\n  const j = $json || {};\n  ds = j.status || 'ok';\n  if (j.approval_id) extra.approval_created = true;\n  if (j.approval_id) extra.approval_id = j.approval_id;\n  note += ' Downstream status: ' + ds + '.';\n} else if (d.path === 'estimator_needs') ds = 'needs_intake';\nelse if (d.path === 'marketer') ds = 'routed_only';\nelse ds = 'held_for_human';\nconst response = { routing: d.routing, downstream_status: ds, ...extra };\nif (d.path === 'estimator_needs') response.note = 'Estimator needs items: ask the client for the missing details';\nif (down) response.downstream = $json;\nreturn [{ json: { response, log_note: note + ' ' + JSON.stringify(d.routing) } }];\n"
   },
   "name": "Prepare response",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
