{
 "name": "Jarvis Intake (Conductor)",
 "nodes": [
  {
   "parameters": {
    "httpMethod": "POST",
    "path": "jarvis/intake",
    "responseMode": "responseNode",
    "options": {
     "allowedOrigins": "https://REPLACE_WITH_DASHBOARD_ORIGIN"
    }
   },
   "name": "Intake Webhook",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2,
   "position": [
    0,
    0
   ],
   "webhookId": "jarvis-intake"
  },
  {
   "parameters": {
    "jsCode": "\nconst b = $input.first().json.body || {};\nconst s = v => (typeof v === 'string' ? v.trim() : '');\nconst errors = [];\nif (!s(b.source)) errors.push('source is required');\nif (!s(b.from)) errors.push('from is required');\nif (!s(b.text)) errors.push('text is required');\nfor (const k of ['subject','client_name','job_name']) if (b[k] !== undefined && b[k] !== null && typeof b[k] !== 'string') errors.push(k + ' must be a string');\nif (s(b.text).length > 8000) errors.push('text too long');\nif (b.items !== undefined && !Array.isArray(b.items)) errors.push('items must be an array');\nreturn [{ json: { valid: errors.length === 0, errors, source: s(b.source), from: s(b.from), subject: s(b.subject), text: s(b.text), client_name: s(b.client_name), job_name: s(b.job_name), items: Array.isArray(b.items) ? b.items : [] } }];\n"
   },
   "name": "Validate",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    220,
    0
   ]
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "typeValidation": "loose"
     },
     "combinator": "and",
     "conditions": [
      {
       "id": "c1",
       "leftValue": "={{ $json.valid }}",
       "rightValue": true,
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ]
    },
    "options": {}
   },
   "name": "Input valid?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    440,
    0
   ]
  },
  {
   "parameters": {
    "respondWith": "json",
    "responseBody": "={{ JSON.stringify({ error: 'Invalid input', details: $json.errors }) }}",
    "options": {
     "responseCode": 400
    }
   },
   "name": "Respond Bad Input",
   "type": "n8n-nodes-base.respondToWebhook",
   "typeVersion": 1.1,
   "position": [
    660,
    180
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "https://REPLACE_WITH_N8N_BASE/webhook/jarvis/inbound",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ source: $json.source, from: $json.from, subject: $json.subject, text: $json.text }) }}",
    "options": {
     "timeout": 60000
    }
   },
   "name": "Call Router",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    660,
    0
   ],
   "onError": "continueErrorOutput",
   "executeOnce": true
  },
  {
   "parameters": {
    "jsCode": "\nconst v = $('Validate').first().json;\nconst r = $json || {};\nconst OK = ['FIRE','IMPORTANT','ROUTINE','AWARENESS'];\nlet path, why;\nif (!OK.includes(r.severity) || typeof r.owner !== 'string') { path = 'human'; why = 'Router response was not usable; held for a human.'; }\nelse if (r.severity === 'FIRE' || r.needs_human === true) { path = 'human'; why = 'Router flagged ' + r.severity + (r.needs_human ? ' / needs_human' : '') + ' (' + (r.reason || 'no reason') + '). No downstream agent called.'; }\nelse if (r.owner === 'Support') { path = 'support'; why = 'Routed to Support for a draft reply.'; }\nelse if (r.owner === 'Estimator') { path = v.items.length ? 'estimator_items' : 'estimator_needs'; why = v.items.length ? 'Routed to Estimator with provided items.' : 'Estimator needs items; none provided, nothing called.'; }\nelse if (r.owner === 'Marketer') { path = 'marketer'; why = 'Routed to Marketer; routing recorded only, nothing called.'; }\nelse { path = 'human'; why = 'Owner ' + r.owner + ' has no automated path; held for a human.'; }\nreturn [{ json: { path, why, routing: r } }];\n"
   },
   "name": "Decide",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    880,
    0
   ]
  },
  {
   "parameters": {
    "rules": {
     "values": [
      {
       "conditions": {
        "options": {
         "caseSensitive": true,
         "typeValidation": "loose"
        },
        "combinator": "and",
        "conditions": [
         {
          "id": "r0",
          "leftValue": "={{ $json.path }}",
          "rightValue": "support",
          "operator": {
           "type": "string",
           "operation": "equals"
          }
         }
        ]
       },
       "renameOutput": true,
       "outputKey": "support"
      },
      {
       "conditions": {
        "options": {
         "caseSensitive": true,
         "typeValidation": "loose"
        },
        "combinator": "and",
        "conditions": [
         {
          "id": "r1",
          "leftValue": "={{ $json.path }}",
          "rightValue": "estimator_items",
          "operator": {
           "type": "string",
           "operation": "equals"
          }
         }
        ]
       },
       "renameOutput": true,
       "outputKey": "estimator_items"
      }
     ]
    },
    "options": {
     "fallbackOutput": "extra",
     "renameFallbackOutput": "local"
    }
   },
   "name": "Route by path",
   "type": "n8n-nodes-base.switch",
   "typeVersion": 3.2,
   "position": [
    1100,
    0
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "https://REPLACE_WITH_N8N_BASE/webhook/jarvis/support",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ client_name: $('Validate').first().json.client_name || $('Validate').first().json.from, message: $('Validate').first().json.text, job_name: $('Validate').first().json.job_name }) }}",
    "options": {
     "timeout": 60000
    }
   },
   "name": "Call Support",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
